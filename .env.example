APP_NAME="ControlOperacionesAgentes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=[SUPABASE_SESSION_POOLER_HOST]
DB_PORT=5432
DB_DATABASE=[SUPABASE_DATABASE]
DB_USERNAME=[SUPABASE_USERNAME]
DB_PASSWORD=[SUPABASE_PASSWORD]
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync

CACHE_STORE=file

JWT_SIGNING_KEY=
JWT_ISSUER=control-operaciones-agente
JWT_AUDIENCE=control-operaciones-agente
JWT_ACCESS_TTL=300
JWT_ABSOLUTE_SESSION_TTL=28800
REFRESH_PEPPER=
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_TEMPORARY_LENGTH=20
PASSWORD_RESET_STEP_UP_MAX_ATTEMPTS=5
PASSWORD_RESET_STEP_UP_DECAY_SECONDS=60

VITE_APP_NAME="${APP_NAME}"
